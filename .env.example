# Copy to .env and fill in. Every key is optional: without them the tool still
# works from the free, key-less sources (football-data.co.uk, ESPN, martj42).

# https://the-odds-api.com  (free plan: 500 credits / month) - live odds snapshots,
# used to build our own odds history for leagues without free historical odds (Chile).
ODDS_API_KEY=

# https://www.football-data.org  (free plan) - fallback / cross-check results source.
FOOTBALL_DATA_ORG_KEY=

# Where data, models and the bet journal live (default: ./data)
# IDEAM_DATA_DIR=

# LightGBM device: "cpu" (default, fastest for this data size) or "gpu" (needs a GPU-enabled build)
# IDEAM_GBM_DEVICE=cpu
